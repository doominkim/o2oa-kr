"blur\\\": {\\\"code\\\": \\\"\\\", \\\"html\\\": \\\"\\\"}}, \\\"properties\\\": {}, \\\"class\\\": \\\"\\\", \\\"styles\\\": {}, \\\"container\\\": \\\"\\\", \\\"moduleName\\\": \\\"log\\\"}}, \\\"fieldList\\\": {}, \\\"formStyleType\\\": \\\"default\\\", \\\"$version\\\": \\\"5.2\\\", \\\"languageType\\\": \\\"none\\\", \\\"afterProcessAction\\\": \\\"close\\\", \\\"isPrompt\\\": true, \\\"promptPosition\\\": \\\"center\\\", \\\"subformList\\\": [], \\\"css\\\": {\\\"code\\\": \\\"\\\\n.ind-doc{font-family:'Noto Sans KR','Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-size:13px;color:#222}\\\\n.ind-head{display:grid;grid-template-columns:1fr auto 1fr;align-items:start;margin-bottom:18px}\\\\n.ind-title{grid-column:2;font-size:26px;font-weight:700;letter-spacing:6px;text-align:center;padding-top:28px;color:#222}\\\\n.ind-boxes{grid-column:3;justify-self:end;display:flex;flex-direction:column;gap:6px;align-items:flex-end}\\\\n.ind-sign{border-collapse:collapse;table-layout:fixed;background:#fff}\\\\n.ind-sign td,.ind-sign th{border:1px solid #9AA4AF;text-align:center;font-size:12px;padding:0 2px;width:72px}\\\\n.ind-sign th.side{width:22px;background:#F2F6F8;color:#444;font-weight:500;line-height:16px}\\\\n.ind-sign td.duty{height:22px;background:#F2F6F8;color:#444}\\\\n.ind-sign td.nm{height:22px;font-weight:500}\\\\n.ind-sign td.st{height:38px}\\\\n.ind-sign td.dt{height:20px;color:#666;font-size:11px}\\\\n.ind-st{display:inline-block;min-width:38px;line-height:30px;height:30px;border-radius:50%;font-weight:700;font-size:12px}\\\\n.ind-st.ok{color:#F0504F;border:2px solid #F0504F}\\\\n.ind-st.rej{color:#fff;background:#F0504F;border-radius:3px;line-height:24px;height:24px;padding:0 6px}\\\\n.ind-st.sub{color:#2768B0;border:2px solid #2768B0}\\\\n.ind-st.wait{color:#B8900F;font-weight:500}\\\\n.ind-st.cur{color:#B8900F;font-weight:700}\\\\n.ind-info{width:100%;border-collapse:collapse;table-layout:fixed;margin-bottom:14px}\\\\n.ind-info td{border:1px solid #D9DEE4;padding:6px 10px;min-height:30px;vertical-align:middle}\\\\n.ind-info td.th{background:#F2F6F8;color:#444;font-weight:500;text-align:center;width:110px}\\\\n.ind-sec{font-size:14px;font-weight:700;color:#2768B0;margin:18px 0 8px;padding-left:8px;border-left:3px solid #2768B0}\\\\n.ind-hint{color:#8C8C8C;font-size:12px}\\\\n\\\", \\\"html\\\": \\\"\\\\n.ind-doc{font-family:'Noto Sans KR','Apple SD Gothic Neo','Malgun Gothic',sans-serif;font-size:13px;color:#222}\\\\n.ind-head{display:grid;grid-template-columns:1fr auto 1fr;align-items:start;margin-bottom:18px}\\\\n.ind-title{grid-column:2;font-size:26px;font-weight:700;letter-spacing:6px;text-align:center;padding-top:28px;color:#222}\\\\n.ind-boxes{grid-column:3;justify-self:end;display:flex;flex-direction:column;gap:6px;align-items:flex-end}\\\\n.ind-sign{border-collapse:collapse;table-layout:fixed;background:#fff}\\\\n.ind-sign td,.ind-sign th{border:1px solid #9AA4AF;text-align:center;font-size:12px;padding:0 2px;width:72px}\\\\n.ind-sign th.side{width:22px;background:#F2F6F8;color:#444;font-weight:500;line-height:16px}\\\\n.ind-sign td.duty{height:22px;background:#F2F6F8;color:#444}\\\\n.ind-sign td.nm{height:22px;font-weight:500}\\\\n.ind-sign td.st{height:38px}\\\\n.ind-sign td.dt{height:20px;color:#666;font-size:11px}\\\\n.ind-st{display:inline-block;min-width:38px;line-height:30px;height:30px;border-radius:50%;font-weight:700;font-size:12px}\\\\n.ind-st.ok{color:#F0504F;border:2px solid #F0504F}\\\\n.ind-st.rej{color:#fff;background:#F0504F;border-radius:3px;line-height:24px;height:24px;padding:0 6px}\\\\n.ind-st.sub{color:#2768B0;border:2px solid #2768B0}\\\\n.ind-st.wait{color:#B8900F;font-weight:500}\\\\n.ind-st.cur{color:#B8900F;font-weight:700}\\\\n.ind-info{width:100%;border-collapse:collapse;table-layout:fixed;margin-bottom:14px}\\\\n.ind-info td{border:1px solid #D9DEE4;padding:6px 10px;min-height:30px;vertical-align:middle}\\\\n.ind-info td.th{background:#F2F6F8;color:#444;font-weight:500;text