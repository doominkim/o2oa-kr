lor:#F4F5F7;\\\\\\\"><div MWFType=\\\\\\\"actionbar\\\\\\\" id=\\\\\\\"actionbar\\\\\\\"><div></div></div><div MWFType=\\\\\\\"div\\\\\\\" id=\\\\\\\"docWrap\\\\\\\" class=\\\\\\\"ind-doc\\\\\\\" style=\\\\\\\"width:920px;margin:16px auto 40px;background:#fff;padding:28px 40px 40px;box-shadow:0 1px 4px rgba(0,0,0,.08);border-radius:8px;box-sizing:border-box;\\\\\\\"><div class=\\\\\\\"ind-head\\\\\\\"><div class=\\\\\\\"ind-title\\\\\\\"><div MWFType=\\\\\\\"label\\\\\\\" id=\\\\\\\"docTitle\\\\\\\"></div></div><div class=\\\\\\\"ind-boxes\\\\\\\"><div MWFType=\\\\\\\"div\\\\\\\" id=\\\\\\\"approvalBox\\\\\\\"></div></div></div><div MWFType=\\\\\\\"table\\\\\\\" id=\\\\\\\"leave_info\\\\\\\"><table class=\\\\\\\"ind-info\\\\\\\" width=\\\\\\\"100%\\\\\\\" border=\\\\\\\"0\\\\\\\" cellpadding=\\\\\\\"0\\\\\\\" cellspacing=\\\\\\\"0\\\\\\\"><tbody><tr><td class=\\\\\\\"th\\\\\\\" MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td5\\\\\\\">문서번호</td><td MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td7\\\\\\\"><div MWFType=\\\\\\\"label\\\\\\\" id=\\\\\\\"docNo\\\\\\\"></div></td><td class=\\\\\\\"th\\\\\\\" MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td8\\\\\\\">기안일</td><td MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td10\\\\\\\"><div MWFType=\\\\\\\"label\\\\\\\" id=\\\\\\\"draftDate\\\\\\\"></div></td></tr><tr><td class=\\\\\\\"th\\\\\\\" MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td11\\\\\\\">기안부서</td><td MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td13\\\\\\\"><div MWFType=\\\\\\\"label\\\\\\\" id=\\\\\\\"draftUnit\\\\\\\"></div></td><td class=\\\\\\\"th\\\\\\\" MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td14\\\\\\\">기안자</td><td MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td16\\\\\\\"><div MWFType=\\\\\\\"label\\\\\\\" id=\\\\\\\"drafter\\\\\\\"></div></td></tr><tr><td class=\\\\\\\"th\\\\\\\" MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td17\\\\\\\">결재자</td><td MWFType=\\\\\\\"table$Td\\\\\\\" id=\\\\\\\"leave_td19\