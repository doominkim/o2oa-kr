h(function (r) { var v = parseFloat(String(r.exAmount == null ? \\\\\\\"\\\\\\\" : r.exAmount).replace(/,/g, \\\\\\\"\\\\\\\")); if (!isNaN(v)) sum += v; });\\\\n    if (F.get(\\\\\\\"expenseTotal\\\\\\\")) F.get(\\\\\\\"expenseTotal\\\\\\\").setData(sum);\\\\n  } catch (err) { console.log(err); }\\\\n};\\\\n\\\", \\\"html\\\": \\\"\\\\n/* 기안 단계가 아니면 문서를 읽기 전용으로 연다 (결재자·합의자·참조자 화면). */\\\\nvar act = this.workContext.getActivity();\\\\nif (act && act.name && act.name !== \\\\\\\"기안\\\\\\\") this.target.json.isReadonly = true;\\\\nvar app = this.form.getApp();\\\\nvar F = this.form, D = this.data;\\\\napp.indigoCalcLeave = function () {\\\\n  try {\\\\n    var t = F.get(\\\\\\\"leaveType\\\\\\\") && F.get(\\\\\\\"leaveType\\\\\\\").getData();\\\\n    var s = F.get(\\\\\\\"leaveStart\\\\\\\") && F.get(\\\\\\\"leaveStart\\\\\\\").getData();\\\\n    var e = F.get(\\\\\\\"leaveEnd\\\\\\\") && F.get(\\\\\\\"leaveEnd\\\\\\\").getData();\\\\n    if (!s || !e) return;\\\\n    var sd = new Date(String(s).substr(0, 10).replace(/-/g, \\\\\\\"/\\\\\\\")), ed = new Date(String(e).substr(0, 10).replace(/-/g, \\\\\\\"/\\\\\\\"));\\\\n    if (isNaN(sd) || isNaN(ed) || ed < sd) return;\\\\n    var n = 0;\\\\n    for (var d = new Date(sd); d <= ed; d.setDate(d.getDate() + 1)) { var w = d.getDay(); if (w !== 0 && w !== 6) n++; }\\\\n    var days = (t === \\\\\\\"오전반차\\\\\\\" || t === \\\\\\\"오후반차\\\\\\\") ? n * 0.5 : n;\\\\n    F.get(\\\\\\\"leaveDays\\\\\\\").setData(days);\\\\n  } catch (err) { console.log(err); }\\\\n};\\\\napp.indigoCalcExpense = function () {\\\\n  try {\\\\n    var dt = D.expenseList, rows = (dt && dt.data) || [], sum = 0;\\\\n    rows.forEach(function (r) { var v = parseFloat(String(r.exAmount == null ? \\\\\\\"\\\\\\\" : r.exAmount).replace(/,/g, \\\\\\\"\\\\\\\")); if (!isNaN(v)) sum += v; });\\\\n    if (F.get(\\\\\\\"expenseTotal\\\\\\\")) F.get(\\\\\\\"expenseTotal\\\\\\\").setData(sum);\\\\n  } catch (err) { console.log(err); }\\\\n};\\\\n\\\"}, \\\"beforeL