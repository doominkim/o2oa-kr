     "beforeArriveScriptText": "\n/* 최종 승인된 휴가를 근태관리(attendancev2) 휴가 신청 기록에 반영한다. 휴가 유형은 서버마다 id가 다르므로 이름으로 찾는다. */\nvar D = this.data;\nif (!D.attendanceLeaveRequestId) {\n  var api = this.Actions.load(\"x_attendance_assemble_control\").LeaveManagerAction;\n  var typeName = D.leaveType, typeId = \"\";\n  api.typeListAll(function (json) {\n    (json.data || []).forEach(function (t) { if (t.name === typeName && t.active !== false) typeId = t.id; });\n  });\n  if (!typeId) {\n    D.attendanceError = \"근태관리에 휴가 유형 '\" + typeName + \"'이(가) 없습니다.\";\n  } else {\n    var fmt = function (s) { s = String(s || \"\"); return s.length === 16 ? s + \":00\" : s; };\n    var work = this.workContext.getWork();\n    api.requestApply({\n      \"person\": work.creatorPerson,\n      \"leaveTypeId\": typeId,\n      \"startTime\": fmt(D.leaveStart),\n      \"endTime\": fmt(D.leaveEnd),\n      \"duration\": parseFloat(D.leaveDays) || 0,\n      \"description\": \"[전자결재 \" + (work.serial || \"\") + \"] \" + (D.leaveReason || \"\")\n    }, function (json) {\n      D.attendanceLeaveRequestId = json.data && json.data.id;\n      D.attendanceError = \"\";\n    }, function (err) {\n      D.attendanceError = \"근태 반영 실패: \" + ((err && err.message) || JSON.stringify(err));\n    });\n  }\n}\n",
     "afterArriveScript": "",
     "beforeExecuteScript": "",
     "afterExecuteScript": "",
     "properties": {},
     "createTime": "2026-11-13 14:37:12",
     "updateTime": "2026-11-13 14:49:32"
    }
   ],
