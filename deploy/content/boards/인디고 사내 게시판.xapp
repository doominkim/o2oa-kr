: flex; background-color: rgb(255, 255, 255); gap: 1em 2em; flex-wrap: wrap; position: relative;\\\\\\\" class\u003d\\\\\\\"form-content-area\\\\\\\"\u003e\u003coo-selector mwftype\u003d\\\\\\\"OOOrg\\\\\\\" id\u003d\\\\\\\"createPerson\\\\\\\" placeholder\u003d\\\\\\\"createPerson\\\\\\\" style\u003d\\\\\\\"\\\\\\\" label-style\u003d\\\\\\\"width:6.2vw; min-width:4.3em; max-width:9em\\\\\\\" label-align\u003d\\\\\\\"right\\\\\\\" view-style\u003d\\\\\\\"background-color:#f7f7f7\\\\\\\" right-icon\u003d\\\\\\\"person\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" label\u003d\\\\\\\"작성자\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\"\u003e\u003cdiv style\u003d\\\\\\\"background: url(\u0026quot;../x_component_process_FormDesigner/Module/Org/default/icon/field.png\u0026quot;) center center no-repeat; width: 18px; height: 18px; float: right;\\\\\\\"\u003e\u003c/div\u003e\u003cdiv style\u003d\\\\\\\"white-space: nowrap; margin-right: 18px; overflow: hidden; margin-left: 2px; line-height: 18px; color: rgb(119, 119, 119); font-family: Verdana, Geneva, sans-serif; font-size: 12px; text-overflow: ellipsis;\\\\\\\"\u003ecreatePerson\u003c/div\u003e\u003c/oo-selector\u003e\u003coo-datetime mwftype\u003d\\\\\\\"OODatetime\\\\\\\" id\u003d\\\\\\\"createTime\\\\\\\" placeholder\u003d\\\\\\\"createTime\\\\\\\" read\u003d\\\\\\\"true\\\\\\\" style\u003d\\\\\\\"\\\\\\\" right-icon\u003d\\\\\\\"calendar\\\\\\\" label-style\u003d\\\\\\\"width:6.2vw; min-width:4.3em; max-width:9em\\\\\\\" label-align\u003d\\\\\\\"right\\\\\\\" view-style\u003d\\\\\\\"background-color:#f7f7f7\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" label\u003d\\\\\\\"작성 일시\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\"\u003e\u003cdiv style\u003d\\\\\\\"background: url(\u0026quot;../x_component_process_FormDesigner/Module/Textfield/default/icon/inputtext.png\u0026quot;) center center no-repeat; width: 18px; height: 18px; float: right;\\\\\\\"\u003e\u003c/div\u003e\u003cdiv style\u003d\\\\\\\"white-space: nowrap; margin-right: 18px; overflow: hidden; margin-left: 2px; line-height: 18px; color: rgb(119, 119, 119); font-family: Verdana, Geneva, sans-serif; font-size: 12px; text-overflow: ellipsis;\\\\\\\"\u003ecreateTime\u003c/div\u003e\u003c/oo-datetime\u003e\u003coo-input mwftype\u003d\\\\\\\"OOInput\\\\\\\" id\u003d\\\\\\\"subject\\\\\\\" placeholder\u003d\\\\\\\"subject\\\\\\\" style\u003d\\\\\\\"flex: 1 1 100%;\\\\\\\" label-style\u003d\\\\\\\"width:6.2vw; min-width:4.3em; max-width:9em\\\\\\\" label-align\u003d\\\\\\\"right\\\\\\\" view-style\u003d\\\\\\\"background-color:#f7f7f7\\\\\\\" readmode\u003d\\\\\\\"false\\\\\\\" type\u003d\\\\\\\"text\\\\\\\" label\u003d\\\\\\\"제　　목\\\\\\\" readonly\u003d\\\\\\\"true\\\\\\\" required\u003d\\\\\\\"true\\\\\\\"\u003e\u003c/oo-input\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_5\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\\\\\\\" id\u003d\\\\\\\"label_2\\\\\\\" style\u003d\\\\\\\"padding: 0.8em 1em; font-size: 1.14286rem; background-color: rgb(255, 255, 255); font-weight: bold; box-shadow: rgb(222, 222, 222) 0px -1px 0px 0px inset; border-left: 4px solid var(--oo-color-main);\\\\\\\" class\u003d\\\\\\\"form-content-section\\\\\\\"\u003e본문\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_6\\\\\\\" style\u003d\\\\\\\"padding: 2em 3em; display: flex; background-color: rgb(255, 255, 255); gap: 1em 2em; flex-wrap: wrap; position: relative;\\\\\\\" class\u003d\\\\\\\"form-content-area\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_4\\\\\\\" style\u003d\\\\\\\"flex: 1 1 100%;\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"htmleditor\\\\\\\" id\u003d\\\\\\\"htmleditor\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv mwftype\u003d\\\\\\\"div\\\\\\\" id\u003d\\\\\\\"div_7\\\\\\\" style\u003d\\\\\\\"\\\\\\\"\u003e\u003cdiv mwftype\u003d\\\\\\\"label\