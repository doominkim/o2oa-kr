# Official O2OA release the image is assembled from (commons, console, release store).
# The fork's web build and changed server classes are layered on top by deploy/build-dist.sh.
RELEASE_VERSION=10.1.0
RELEASE_URL=https://mirror1.o2oa.net/download/o2server-10.1.0-linux-x64.zip
RELEASE_SHA256=80fa1236433113fd433f783922f50c6514875b596d906830d39cd7033de861c6
# Upstream commit the fork branched from; Java files changed since then are patched in.
UPSTREAM_BASE=0fcc45a3
# Compile-only jar: release StorageObject references webdav4 config classes that the release does not ship.
COMPILE_DEP_URL=https://repo1.maven.org/maven2/org/apache/commons/commons-vfs2-jackrabbit2/2.10.0/commons-vfs2-jackrabbit2-2.10.0.jar
COMPILE_DEP_SHA256=7ae9702484be4871f17e43923e1e34c09cd0b183de956593447a07bc4df4f4d7
