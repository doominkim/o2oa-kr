{


    "node": {
        "margin": "0px",
        "overflow": "hidden",
        "background-color": "#fff",
        "position": "absolute",
        "width": "100%",
        "top": "0px",
        "left": "200px",
        "display": "block",
        "opacity": "0"
    },

    "scrollNode" : {
        "overflow-x": "hidden",
        "overflow-y": "scroll"
    },
    "scrollNode_inContainer" : {
        "overflow-x": "hidden",
        "overflow-y": "scroll",
        "background-color" : "#f0f0f0"
    },
    "contentWarpNode" : {
        "margin" : "0px auto 20px 20px",
        "overflow" : "hidden"
    },
    "contentContainerNode" : {
        "height" : "100%",
        "overflow": "hidden"
    },
    "contentNode" : {
        "background-color": "#FFF",
        "-webkit-user-select": "none",
        "-moz-user-select": "none"
    },

    "calendarTitleNode": {
        "height": "50px",
        "overflow": "hidden",
        "display": "flex",
        "align-items": "center",
        "padding-left": "20px",
        "box-sizing": "border-box"
    },
    "calendarBodyNode": {
        "overflow": "hidden"
    },

    "calendarPrevMonthNode": {
        "order": "1",
        "box-sizing": "border-box",
        "height": "26px",
        "width": "26px",
        "line-height": "26px",
        "text-align": "center",
        "margin": "0px 0px 0px 12px",
        "border": "1px solid #CCD1D9",
        "border-radius": "2px 0px 0px 2px",
        "background-color": "#FFF",
        "color": "#666",
        "font-size": "14px",
        "cursor": "pointer"
    },
    "calendarPrevMonthNode_over": {
        "color": "#2768B0"
    },
    "calendarPrevMonthNode_down": {
    },
    "calendarNextMonthNode": {
        "order": "2",
        "box-sizing": "border-box",
        "height": "26px",
        "width": "26px",
        "line-height": "26px",
        "text-align": "center",
        "margin": "0px 0px 0px -1px",
        "border": "1px solid #CCD1D9",
        "border-radius": "0px 2px 2px 0px",
        "background-color": "#FFF",
        "color": "#666",
        "font-size": "14px",
        "cursor": "pointer"
    },
    "calendarNextMonthNode_over": {
        "color": "#2768B0"
    },
    "calendarNextMonthNode_down": {
    },
    "calendarTodayNode": {
        "order": "3",
        "box-sizing": "border-box",
        "height": "26px",
        "line-height": "26px",
        "padding": "0px 12px",
        "margin-left": "6px",
        "border": "1px solid #CCD1D9",
        "border-radius": "2px",
        "background-color": "#FFF",
        "color": "#333",
        "font-size": "12px",
        "cursor": "pointer"
    },
    "calendarTitleTextNode": {
        "order": "0",
        "line-height": "28px",
        "color" : "#222",
        "margin": "0px",
        "font-size": "18px",
        "font-weight": "bold",
        "cursor": "pointer"
    },
    "calendarTitleTextNode_over": {
        "color": "#2768B0"
    },
    "calendarTitleTextNode_down": {
        "color": "#2768B0"
    },
    "calendarMonthSelectNode": {
        "width": "260px",
        "height": "310px",
        "background-color": "#FFF",
        "position": "absolute",
        "text-align": "center",
        "box-shadow": "0 0 8px 0 rgba(0,0,0,0.25)",
        "border-radius" : "8px"
    },
    "calendarMonthSelectTitleNode": {
        "color" : "#666",
        "background-color": "#f7f7f7",
        "overflow": "hidden"
    },
    "calendarMonthSelectTitlePrevYearNode": {
        "height": "50px",
        "line-height": "50px",
        "width": "20px",
        "padding-left": "10px",
        "padding-right": "10px",
        "float": "left",
        "color": "#999",
        "font-size": "15px",
        //"background": "url(../x_component_Meeting/$MonthView/default/icon/icon_left.png) no-repeat center center",
        "cursor": "pointer"
    },
    "calendarMonthSelectTitleNextYearNode": {
        "height": "50px",
        "line-height": "50px",
        "width": "20px",
        "padding-left": "10px",
        "padding-right": "10px",
        "float": "right",
        "color": "#999",
        "font-size": "15px",
        //"background": "url(../x_component_Meeting/$MonthView/default/icon/icon_right.png) no-repeat center center",
        "cursor": "pointer"
    },
    "calendarMonthSelectTitleTextNode": {
        "text-align": "center",
        "margin": "0px 40px",
        "height": "50px",
        "font-size": "20px",
        "line-height": "50px"
    },
    "calendarMonthSelectCurrentNode" : {
        "color" : "#2768B0",
        "cursor": "pointer",
        "font-size": "14px",
        "height" : "30px",
        "line-height" : "30px",
        "border-radius" : "100px",
        "width" : "30px",
        "border" : "1px solid #2768B0",
        "background-color" : "#fff",
        "margin" : "auto"
    },
    "calendarMonthSelectTodayNode" : {
        "color" : "#fff",
        "cursor": "pointer",
        "font-size": "14px",
        "height" : "30px",
        "line-height" : "30px",
        "border-radius" : "100px",
        "width" : "30px",
        "border" : "1px solid #2768B0",
        "background-color" : "#2768B0",
        "margin" : "auto"
    },
    "calendarMonthSelectTdNode": {
        "cursor": "pointer",
        "height" : "30px",
        "width" : "30px",
        "color": "#333",
        "font-size": "14px"
    },
    "calendarMonthSelectTdNode_over": {
        "color": "#2768B0"
    },
    "calendarMonthSelectTdNode_down": {
        "color": "#8894e9"
    },

    "calendarMonthSelectBottomNode": {
        "height": "50px",
        "font-size": "18px",
        "line-height": "40px",
        "cursor": "pointer",
        "color": "#333"
    },
    "calendarMonthSelectBottomNode_over": {
        "color": "#2768B0"
    },


    "calendarTable": {
        "width": "100%",
        "table-layout" : "fixed",
        "border-left": "1px solid #E6E6E6"
    },
    "calendarTableTitleTr": {
        "height": "36px"
    },
    "calendarTableTh": {
        "width": "14.28%",
        "background-color" : "#F2F6F8",
        "color": "#222",
        "font-size": "13px",
        "font-weight" : "bold",
        "min-width": "120px",
        "border-top": "1px solid #E6E6E6",
        "border-right": "1px solid #E6E6E6",
        "border-bottom": "1px solid #E6E6E6",
        "text-align" : "center"
    },
    "calendarTableTh_sunday": {
        "color": "#E5484D"
    },
    "calendarTableTh_saturday": {
        "color": "#2768B0"
    },
    "calendarTableCell_thisMonth": {
        "margin": "0px",
        "overflow": "hidden",
        "background-color": "#fff",
        "border-right": "1px solid #E6E6E6",
        "border-bottom": "1px solid #E6E6E6",
        "height" : "140px"
    },
    "calendarTableCell_otherMonth": {
        "margin": "0px",
        "overflow": "hidden",
        "color" : "#ccc",
        "background-color": "#fff",
        "border-right": "1px solid #E6E6E6",
        "border-bottom": "1px solid #E6E6E6",
        "height" : "140px"
    },
    "calendarTableCell_today": {
        "margin": "0px",
        "overflow": "hidden",
        "background-color": "#EAF2FB",
        "box-shadow": "inset 0 0 0 1px #2768B0",
        "border-right": "1px solid #E6E6E6",
        "border-bottom": "1px solid #E6E6E6",
        "height" : "140px"
    },

    "dayTitle_thisMonth": {
        "padding" : "5px 0px 3px 8px",
        "height": "22px",
        "cursor": "pointer",
        "line-height": "22px"
    },
    "dayTitle_otherMonth": {
        "padding" : "5px 0px 3px 8px",
        "height": "22px",
        "cursor": "pointer",
        "line-height": "22px"
    },
    "dayTitle_today": {
        "padding" : "5px 0px 3px 6px",
        "height": "22px",
        "cursor": "pointer",
        "line-height": "22px"
    },
    "dayTitleDay_thisMonth": {
        "font-size" : "13px",
        "min-width" : "20px",
        "height": "22px",
        "float": "left",
        "color": "#222"
    },
    "dayTitleDay_otherMonth": {
        "font-size" : "13px",
        "min-width" : "20px",
        "height": "22px",
        "float": "left",
        "color": "#BBBBBB"
    },
    "dayTitleDay_sunday_thisMonth": {
        "color": "#E5484D"
    },
    "dayTitleDay_sunday_otherMonth": {
        "color": "#F2A4A6"
    },
    "dayTitleDay_saturday_thisMonth": {
        "color": "#2768B0"
    },
    "dayTitleDay_saturday_otherMonth": {
        "color": "#A9C3DF"
    },
    "dayTitleDay_today": {
        "font-size" : "12px",
        "font-weight" : "bold",
        "background": "#2768B0",
        "border-radius": "100px",
        "text-align" : "center",
        "line-height": "22px",
        "width": "22px",
        "height": "22px",
        "float": "left",
        "color": "#fff"
    },
    "dayTitleInfor_thisMonth": {
        "margin-right": "8px",
        "height": "22px",
        "font-size" : "12px",
        "line-height": "22px",
        "text-align": "right",
        "color": "#2768B0"
    },
    "dayTitleInfor_otherMonth": {
        "margin-right": "8px",
        "height": "22px",
        "font-size" : "12px",
        "line-height": "22px",
        "text-align": "right",
        "color": "#999"
    },
    "dayTitleInfor_today": {
        "margin-right": "8px",
        "height": "22px",
        "font-size" : "12px",
        "line-height": "22px",
        "text-align": "right",
        "color": "#2768B0"
    },

    "dayContentNode": {
        "overflow": "hidden",
        //"border-top": "1px solid #ccc",
        "margin": "0px 5px 0px 0px"
    },
    "meetingNode_today": {
        "height": "24px",
        "background-color": "transparent",
        "margin": "0px 4px",
        "border-radius": "2px",
        "cursor": "pointer",
        "font-size": "12px",
        "color": "#222",
        "line-height": "24px"
    },
    "meetingNode": {
        "height": "24px",
        "background-color": "transparent",
        "margin": "0px 4px",
        "border-radius": "2px",
        "cursor": "pointer",
        "font-size": "12px",
        "color": "#222",
        "line-height": "24px"
    },
    "meetingNode_over" : {
        "background-color": "#F4F5F7",
        "color" : "#2768B0"
    },
    "meetingIconNode": {
        "height": "6px",
        "width": "6px",
        "margin": "9px 5px 0px 4px",
        "border-radius": "1px",
        "background-color": "#2768B0",
        "float": "left"
    },
    "meetingTextNode": {
        "height": "24px",
        "overflow": "hidden",
        "white-space": "nowrap",
        "text-overflow": "ellipsis"
    },
    "meetingTimeNode":{
        "height": "24px",
        "color" : "#222",
        "font-weight" : "bold",
        "font-size": "12px",
        "margin-right": "4px",
        "float": "left"
    }

}
