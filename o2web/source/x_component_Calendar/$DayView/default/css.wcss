{
  "node": {
    "margin": "0px",
    "overflow": "hidden",
    "background-color": "#fff",
//    "position": "absolute",
    "width": "100%",
//    "top": "0px",
//    "left": "200px",
    "display": "block",
    "opacity": "0"
  },

  "scrollNode" : {
    "overflow-x": "hidden",
    "overflow-y": "scroll"
  },
  "scrollNode_inContainer" : {
    "overflow-x": "hidden",
    "overflow-y": "hidden",
    "background-color" : "#f0f0f0"
  },
  "contentWarpNode" : {
    //"width": "1170px",
    "margin" : "0px auto 20px auto",
    "overflow" : "hidden"
  },
  "contentContainerNode" : {
    "height" : "100%",
    "overflow": "hidden"
  },
  "contentNode" : {
    "background-color": "#FFF",
    "-webkit-user-select": "none",
    "-moz-user-select": "none"
  },

  "calendarTitleNode": {
    "height": "50px",
    "overflow": "hidden",
    "display": "flex",
    "align-items": "center",
    "padding-left": "20px",
    "box-sizing": "border-box"
  },
  "calendarBodyNode": {
    "overflow": "hidden"
  },

  "calendarPrevDayNode": {
    "order": "1",
    "box-sizing": "border-box",
    "height": "28px",
    "width": "28px",
    "line-height": "26px",
    "text-align": "center",
    "margin": "0px 0px 0px 12px",
    "border": "1px solid #CCD1D9",
    "border-radius": "2px 0px 0px 2px",
    "background-color": "#FFF",
    "color": "#666",
    "font-size": "14px",
    "cursor": "pointer"
  },
  "calendarPrevDayNode_over": {
        "color": "#2768B0"
    //"background": "url(../x_component_Calendar/$WeekView/default/icon/left24_blue.png) no-repeat center center"
  },
  "calendarPrevDayNode_down": {
    //"background": "url(../x_component_Calendar/$WeekView/default/icon/left24_blue.png) no-repeat center center"
  },
  "calendarNextDayNode": {
    "order": "2",
    "box-sizing": "border-box",
    "height": "28px",
    "width": "28px",
    "line-height": "26px",
    "text-align": "center",
    "margin": "0px 0px 0px -1px",
    "border": "1px solid #CCD1D9",
    "border-radius": "0px 2px 2px 0px",
    "background-color": "#FFF",
    "color": "#666",
    "font-size": "14px",
    "cursor": "pointer"
  },
  "calendarNextDayNode_over": {
        "color": "#2768B0"
        //"background": "url(../x_component_Calendar/$WeekView/default/icon/right24_blue.png) no-repeat center center"
  },
  "calendarNextDayNode_down": {
    //"background": "url(../x_component_Calendar/$WeekView/default/icon/right24_blue.png) no-repeat center center"
  },
  "calendarTitleTextNode": {
    "order": "0",
    "line-height": "28px",
    "color" : "#222",
    "margin": "0px",
    "font-size": "18px",
    "font-weight": "bold",
    "cursor": "pointer"
  },
  "calendarTitleTextNode_over": {
    "color": "#2768B0"
  },
  "calendarTitleTextNode_down": {
    "color": "#2768B0"
  },


  "titleTable" : {
    "margin" : "0px auto 0px 12px",
    "width": "100%",
    "table-layout" : "fixed",
    "font-size" : "12px"
  },
  "calendarTable": {
    "width": "100%",
    "table-layout" : "fixed",
    "font-size" : "12px"
  },
  "calendarTableTitleTr": {
    "height": "40px"
  },
  "calendarTableTh_hour": {
    "background-color" : "#F2F6F8",
    "color": "#8C8C8C",
    "font-size": "12px",
    "font-weight" : "normal",
    "border-top": "1px solid #E6E6E6",
    "border-bottom": "1px solid #E6E6E6",
    "border-left": "1px solid #E6E6E6",
    "text-align" : "center",
    "overflow" : "hidden"
  },
  "calendarTableTh": {
    "background-color" : "#F2F6F8",
    "color": "#222",
    "font-size": "13px",
    "font-weight" : "normal",
    "min-width": "120px",
    "border-top": "1px solid #E6E6E6",
    "border-bottom": "1px solid #E6E6E6",
    "border-left": "1px solid #E6E6E6",
    "text-align" : "center",
    "overflow" : "hidden"
  },
  "calendarTableThDay" : {
    "font-size": "13px",
    "font-weight" : "bold"
  },
  "calendarTableThDate" : {
    "float" : "right",
    "font-size": "12px",
    "font-weight" : "normal"

  },
  "calendarTableCell_hour" : {
    "overflow": "hidden",
    "background-color": "#fff",
    "color": "#8C8C8C",
    "border-bottom": "1px solid #E6E6E6",
    "border-left": "1px solid #E6E6E6",
    "width" : "50px",
    "text-align" : "center",
    "height" : "47px"
  },
  "calendarTableCell" : {
    "overflow": "hidden",
    "background-color": "#fff",
    "border-bottom": "1px solid #E6E6E6",
    "border-left": "1px solid #E6E6E6",
    "height" : "47px"
  },
  "calendarTableCell_thisWeek": {
    "overflow": "hidden",
    "background-color": "#fff",
    "border-bottom": "1px solid #E6E6E6",
    "border-left": "1px solid #E6E6E6",
    "height" : "47px"
  },
  "calendarTableCell_otherWeek": {
    "overflow": "hidden",
    "color" : "#ccc",
    "background-color": "#fff",
    "border-bottom": "1px solid #E6E6E6",
    "height" : "47px"
  },
  "calendarTableCell_today": {
    "overflow": "hidden",
    "background-color": "#EAF2FB",
    "border-bottom": "1px solid #E6E6E6",
    "height" : "47px"
  },


  "createCalendarAction" : {
    "float" : "left",
    "padding-left" : "5px",
    "width" : "16px",
    "height" : "16px",
    "background" : "url(../x_component_Calendar/$Main/default/icon/icon_newapply.png) no-repeat center center"
  },
  "createCalendarAction_over" : {
    "background" : "url(../x_component_Calendar/$Main/default/icon/icon_newapply_click.png) no-repeat center center"
  }

}
