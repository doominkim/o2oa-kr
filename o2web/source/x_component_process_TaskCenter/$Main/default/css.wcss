    },
    "listHeadIconCellNode": {
        "flex": "0 0 45px"
    },
    "listHeadDateCellNode": {
        "flex": "0 0 120px"
    },
    "listHeadTitleCellNode": {
        "flex": "1",
        "min-width": "0px"
    },
    "listHeadCreatorCellNode": {
        "flex": "0 0 140px"
    },
    "listHeadStatusCellNode": {
        "flex": "0 0 170px"
    },
    "listHeadActionCellNode": {
        "flex": "0 0 33px"
    },
    "listEmptyNode": {
        "padding": "80px 0px",
        "text-align": "center"
    },
    "listEmptyIconNode": {
        "width": "64px",
        "height": "64px",
        "margin": "0px auto 12px auto",
