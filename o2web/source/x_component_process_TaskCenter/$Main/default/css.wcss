    },
    "listEmptyTextNode": {
        "font-size": "12px",
        "color": "#8C8C8C"
    },
    "listScrollAreaNode": {
        "overflow": "hidden",
        "margin": "0px"
    },
    "listAreaNode": {
        "overflow": "hidden",
        "padding-bottom": "12px"
    },

    //Item: card row (54px high, 6px gap)
    "itemNode": {
        "height": "54px",
        "position": "static",
