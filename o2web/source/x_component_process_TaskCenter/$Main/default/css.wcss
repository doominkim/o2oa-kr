{
    "taskTitleBar": {
        "overflow": "hidden",
        "height": "50px",
        "background-color": "#4e82bd"
    },
    "startProcessAction": {
        "width": "59px",
        "height": "50px",
        "background": "url("+"../x_component_process_TaskCenter/$Main/default/icon/stratProcess.png) center center no-repeat",
        "float": "left",
        //"border-right": "1px solid #FFF",
        "cursor": "pointer"
    },

    //PC frame: module bar + LNB + main area
    "moduleBarNode": {
        "height": "44px",
        "background-color": "#2768B0",
        "display": "flex",
        "align-items": "center",
        "padding": "0px 16px",
        "overflow": "hidden",
        "box-sizing": "border-box"
    },
    "moduleMenuNode": {
        "width": "24px",
        "height": "24px",
        "flex": "none",
        "margin-right": "12px",
        "background": "url("+"../x_component_process_TaskCenter/$Main/default/lnb/menu.svg) center center no-repeat",
        "cursor": "pointer"
    },
    "moduleTitleNode": {
        "flex": "1",
        "color": "#FFFFFF",
        "font-size": "18px",
        "line-height": "44px",
        "font-weight": "500",
        "white-space": "nowrap",
        "overflow": "hidden"
    },
    "moduleActionNode": {
        "flex": "none",
        "height": "28px",
        "line-height": "26px",
        "padding": "0px 12px",
        "border": "1px solid rgba(255,255,255,0.7)",
        "border-radius": "2px",
        "color": "#FFFFFF",
        "font-size": "12px",
        "box-sizing": "border-box",
        "cursor": "pointer"
    },
    "bodyNode": {
        "display": "flex",
        "overflow": "hidden",
        "background-color": "#FFFFFF"
    },
    "lnbNode": {
        "display": "block",
        "width": "192px",
        "flex": "0 0 192px",
        "background-color": "#FFFFFF",
        "border-right": "1px solid #EDEFF2",
        "box-sizing": "border-box",
        "overflow-x": "hidden",
        "overflow-y": "auto"
    },
    "mainNode": {
        "flex": "1",
        "min-width": "0px",
        "overflow": "hidden",
        "background-color": "#FFFFFF"
    },
    "mainTitleNode": {
        "height": "50px",
        "display": "flex",
        "align-items": "center",
        "padding": "0px 24px",
        "border-bottom": "1px solid #EDEFF2",
        "box-sizing": "border-box"
    },
    "mainTitleTextNode": {
        "font-size": "18px",
        "color": "#222222",
        "font-weight": "500",
        "white-space": "nowrap"
    },
    "mainTitleCountNode": {
        "margin-left": "8px",
        "font-size": "13px",
        "font-weight": "bold",
        "color": "#2768B0",
        "white-space": "nowrap"
    },
    "startProcessAction_pc": {
        "height": "34px",
        "line-height": "34px",
        "margin": "12px 12px 8px 12px",
        "background-color": "#2768B0",
        "color": "#FFFFFF",
        "font-size": "13px",
        "text-align": "center",
        "border-radius": "2px",
        "cursor": "pointer"
    },
    "startProcessAction_pc_over": {
        "background-color": "#1F5A9C"
    },
    "lnbMenuNode": {
        "padding": "4px 0px 16px 0px"
    },
    "lnbGroupNode": {
        "height": "36px",
        "display": "flex",
        "align-items": "center",
        "padding": "0px 16px",
        "margin-top": "6px"
    },
    "lnbGroupIconNode": {
        "width": "16px",
        "height": "16px",
        "flex": "none",
        "margin-right": "8px",
        "background-position": "center center",
        "background-repeat": "no-repeat"
    },
    "lnbGroupTextNode": {
        "font-size": "13px",
        "font-weight": "bold",
        "color": "#222222"
    },
    "lnbItemNode": {
        "height": "32px",
        "display": "flex",
        "align-items": "center",
        "padding": "0px 16px 0px 40px",
        "font-size": "13px",
        "color": "#444444",
        "font-weight": "normal",
        "background-color": "transparent",
        "cursor": "pointer"
    },
    "lnbItemNode_over": {
        "color": "#222222",
        "font-weight": "normal",
        "background-color": "#F5F7FA"
    },
    "lnbItemNode_current": {
        "color": "#2768B0",
        "font-weight": "bold",
        "background-color": "#EAF2FB"
    },
    "lnbItemTextNode": {
        "flex": "1",
        "min-width": "0px",
        "overflow": "hidden",
        "white-space": "nowrap",
        "text-overflow": "ellipsis"
    },
    "lnbItemCountNode": {
        "flex": "none",
        "margin-left": "6px",
        "font-size": "12px",
        "font-weight": "normal",
        "color": "#2768B0"
    },
    "searchBarAreaNode_pc": {
        "margin-left": "auto",
        "height": "28px"
    },
    "searchBarNode_pc": {
        "width": "240px",
        "height": "28px",
        "background-color": "#FFFFFF",
        "border": "1px solid #D9D9D9",
        "border-radius": "2px",
        "box-sizing": "border-box"
    },
    "searchBarActionNode_pc": {
        "width": "28px",
        "height": "26px",
        "background-image": "url("+"../x_component_process_TaskCenter/$Main/default/icon/search.png)",
        "background-position": "center center",
        "background-repeat": "no-repeat",
        "background-size": "18px 18px",
        "float": "right",
        "cursor": "pointer"
    },
    "searchBarInputBoxNode_pc": {
        "height": "26px",
        "overflow": "hidden",
        "margin-left": "8px",
        "margin-right": "30px"
    },
    "searchBarInputNode_pc": {
        "font-size": "12px",
        "width": "100%",
        "height": "26px",
        "line-height": "26px",
        "padding": "0px",
        "border": "0px",
        "outline": "none",
        "background-color": "transparent",
        "color": "#666666"
    },
    "searchBarAreaNode": {
        "margin": "0px 110px 0px 160px",
        "height": "50px",
        "overflow": "hidden"
    },
    "searchBarNode": {
        "width": "99%",
        "max-width": "480px",
        "height": "24px",
        "background-color": "#FFF",
        "border": "0px solid #999",
        "border-radius":"4px",
        "margin-top": "13px",
        "float": "right"
    },
    "searchBarActionNode": {
        "width": "40px",
        "height": "24px",
        "background": "url("+"../x_component_process_TaskCenter/$Main/default/icon/search.png) center center no-repeat",
        "float": "right",
        "cursor": "pointer"
    },
    "searchBarInputBoxNode": {
        "height": "24px",
        "line-height": "20px",
        "overflow": "hidden",
        "margin-left": "10px",
        "margin-right": "50px"
    },
    "searchBarInputNode": {
        "font-size":"12px",
        "width": "100%",
        "height": "20px",
        "border": "0px",
        "color": "#666"
    },
    "tabAreaNode": {
        "min-height": "40px",
        "overflow": "hidden",
        "border-bottom": "1px solid #dedede",
        "background-color": "#FFF"
    },

    "tabItemNode": {
        "margin-left": "10px",
        "height": "40px",
        "float": "left",
        "background-color": "#FFF",
        "cursor": "pointer"
    },
    "tabItemTextNode": {
        "float": "left",
        "height": "40px",
        "font-size": "14px",
        "line-height": "40px",
        "color": "#333333"
    },
    "tabItemTextNode_current": {
        "color": "#3c76b7"
    },
    "tabItemCountNode": {
        "padding": "0px 5px",
        "color": "#666",
        "font-size": "12px",
        "line-height": "40px",
        "border-radius": "8px",
        "float": "left",
        "min-width": "12px",
        "text-align": "center"
    },
    "contentNode": {
        "clear": "both"
    },
    "contentListAreaNode": {
        "width": "10px",
        "height": "100%"
    },
    "maskNode": {
        "background-color": "#666",
        "opacity": 0.4,
        "z-index":100
    },

    //List....
    "listContentNode": {
        //"overflow": "hidden",
        "float": "left",
        "height": "100%"
    },
    "actionBarNode": {
        "min-height": "40px",
        "border-bottom": "1px solid #EDEFF2"
    },
    "filterActionNode": {
        "float": "right",
        "height": "28px",
        "line-height": "26px",
        "margin-top": "6px",
        "padding": "0px 10px 0px 28px",
        "box-sizing": "border-box",
        "border": "1px solid #CCD1D9",
        "border-radius": "2px",
        "font-size": "12px",
        "color": "#333333",
        "cursor": "pointer",
        "background-color": "#FFFFFF",
        "background-image": "url("+"../x_component_process_TaskCenter/$Main/default/icon/filter.png)",
        "background-position": "8px center",
        "background-repeat": "no-repeat"
    },
    "applicationFilterAreaNode": {
        "margin-right": "80px",
        "min-height": "40px"
    },
    "appFilterNode_current": {
        "float": "left",
        "height": "38px",
