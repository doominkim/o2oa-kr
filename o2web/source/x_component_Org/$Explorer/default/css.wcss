{
  "listAreaNode": {
    "height": "100%",
    "width": "300px",
    "overflow": "hidden",
    "float": "left",
    "background-color": "#FFFFFF"
  },
  "propertyAreaNode": {
    "height": "100%",
    "margin-left": "300px",
    "overflow": "hidden",
    "background-color": "#FFFFFF"
  },
  "resizeBarNode": {
    "height": "100%",
    "width": "3px",
    "float": "left",
    "overflow": "hidden",
    "border-left": "1px solid #E6E6E6",
    "background-color": "#FFFFFF",
    "cursor": "col-resize"
  },
  "propertyNode": {
    "margin-left": "4px",
    "height": "100%",
    "overflow": "hidden",
  },
  "propertyTitleNode": {
    "background-color": "#FFFFFF",
    "border-bottom": "1px solid #EDEFF2",
    "height": "0px",
    "color": "#222222",
    "margin": "0px 0px",
    "text-align": "center",
    "line-height": "40px",
    "font-size": "18px",
    "overflow": "hidden"
  },
  "propertyTitleTextNode": {

  },
  "propertyContentNode": {
    "overflow": "hidden",
    "-webkit-user-select": "text",
    "-moz-user-select": "text",
    "margin": "0px"
  },

  "rootNameNode": {
    "height": "44px",
    "padding": "0 16px 0 40px",
    "line-height": "44px",
    "font-size": "14px",
    "font-weight": "bold",
    "color": "#222222",
    "background": "#FFFFFF url("+"../x_component_Org/$Explorer/default/icon/unit.png) 16px center / 16px no-repeat",
    "border-bottom": "1px solid #EDEFF2",
    "white-space": "nowrap",
    "text-overflow": "ellipsis",
    "overflow": "hidden"
  },

  "toolbarNode": {
    "height": "32px",
    "padding": "8px 8px 8px 12px",
    "background-color": "#FFFFFF",
    "border-bottom": "1px solid #EDEFF2",
    "position": "relative"
  },
  "listScrollNode": {
    "overflow": "hidden"
  },
  "listNode": {
    "min-height": "100%",
    "overflow": "hidden"
  },
  "addTopGroupNode": {
    "background": "#FFFFFF url("+"../x_component_Org/$Explorer/default/icon/add.png) center center no-repeat",
    "width": "30px",
    "height": "30px",
    "border": "1px solid #CCD1D9",
    "border-radius": "2px",
    "cursor": "pointer",
    "float": "right"
  },
  "filterNode": {
    "position": "absolute",
    "background": "url("+"../x_component_Org/$Explorer/default/icon/filter.png) center center no-repeat",
    "background-size": "12px",
    "width": "24px",
    "height": "48px",
    "cursor": "pointer",
    "right": "49px",
    "top": "0"
  },
  "filterSearchAction":{
    "width":"80px",
    "text-align": "center",
    "height": "28px",
    "line-height": "28px",
    "cursor": "pointer",
    "font-size": "12px",
    "border": "1px solid #2768B0",
    "background-color": "#2768B0",
    "color": "#ffffff",
    "border-radius": "2px"
  },
  "searchNode": {
    "margin-right": "40px",
    "height": "30px",
    "border": "1px solid #D9D9D9",
    "border-radius": "2px",
    "background-color": "#FFFFFF"
  },
  "searchButtonNode": {
    "float": "left",
    "width": "30px",
    "height": "30px",
