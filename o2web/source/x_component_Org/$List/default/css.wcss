{
    "listTitle": {
        "background-color": "#F2F6F8",
        "height": "30px",
        "line-height": "30px",
        "font-size": "12px",
        "font-weight": "normal",
        "color": "#8C8C8C",
        "text-align": "left"
    },
    "contentTrNode": {
        "height": "30px",
        "line-height": "30px",
        "background": "transparent",
        "border-bottom": "1px solid #EDEFF2"
    },
    "contentTrNode_selected": {
        "background": "#EAF2FB",
        //"background": "#FFFFDD",
        "border-bottom": "1px solid #EDEFF2"
    },
    "contentTdNode": {
        "text-align": "left",
        "font-size": "13px",
        "color": "#222222",
        "border-bottom": "1px solid #EDEFF2"
    },
    "selectTdNode":{
        "cursor": "pointer",
        "background": "url("+"../x_component_Org/$List/default/icon/select.png) center center no-repeat",
        "border-bottom": "1px solid #EDEFF2"
    },
    "selectTdNode_selected":{
        "border-bottom": "1px solid #EDEFF2",
        "cursor": "pointer",
        "background": "url("+"../x_component_Org/$List/default/icon/selected.png) center center no-repeat",
    },
    "blankTdNode": {
        "border-bottom": "1px solid #EDEFF2"
    },
    "actionAreaNode": {
        "width": "auto",
        "margin": "0px 24px",
        "height": "20px",
        "overflow": "visible"
    },
    "actionNode": {
        "position": "relative",
        "top": "32px",
        "margin-right": "10px"
    },
    "addActionNode": {
        "background": "url("+"../x_component_Org/$List/default/icon/additem.png) 3px center no-repeat",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #CCD1D9",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#333",
        "border-radius":"2px"
    },
    "deleteActionNode_disabled": {
        "background": "url("+"../x_component_Org/$List/default/icon/deleteitem_disable.png) 3px center no-repeat",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #E6E6E6",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#BBB",
        "border-radius":"2px"
    },
    "deleteActionNode": {
        "background": "url("+"../x_component_Org/$List/default/icon/deleteitem.png) 3px center no-repeat",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #CCD1D9",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#333",
        "border-radius":"2px"
    },
    "inputNode": {
        "width": "80%",
        "border": "1px solid #D9D9D9",
        "border-radius": "2px",
        "outline": "none",
        "background": "#FFFFFF",
        "padding": "0px 8px",
        "font-size": "13px",
        "line-height": "26px",
        "height": "26px",
        "text-align": "left",
        "color": "#222222"
    },
    "sortActionNode": {
        "background": "url(../x_component_Org/$List/default/icon/order.png) 3px center no-repeat",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #CCD1D9",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#333",
        "border-radius":"2px"
    },
    "okActionNode": {
        "background": "url(../x_component_Org/$Explorer/default/icon/mainid.png) 5px center no-repeat",
        "background-size": "12px",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #CCD1D9",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#333",
        "border-radius":"2px"
    },
    "cancelActionNode": {
        //        "background": "url(../x_component_Org/$List/default/icon/order.png) 3px center no-repeat",
        "float": "right",
        "cursor": "pointer",
        "margin-top": "0px",
        "margin-left": "5px",
        "padding": "5px 10px",
        //        "padding-left": "22px",
        "font-size": "12px",
        "font-weight": "normal",
        "border": "1px solid #CCD1D9",
        "background-color": "#FFF",
        "line-height": "normal",
        "color":"#333",
        "border-radius":"2px"
    }
}