{
	"rightContentNode": {
		"height": "100%",
		"margin-left": "0px",
		"overflow": "hidden",
		"background-color": "#FFFFFF",
		"opacity": 1
	},


	"startMenuNode": {
		"overflow": "hidden",
		"position": "absolute",
		"height": "160px",
		"margin": "auto"
	},


	"startMenuNaviNode": {
		"width": "120px",
		"height": "120px",
		"float": "left",
		"margin": "20px",
		"cursor": "pointer",
		"box-shadow": "0px 0px 0px",
		"background-color": "#FFFFFF"
	},
	"startMenuNaviNode_over": {
        "width": "140px",
		"height": "140px",
		"margin": "10px",
		"box-shadow": "3px 3px 8px #cccccc",
	},
	"startMenuNaviNode_current": {

	},
	"startMenuNaviNode_down": {
        "box-shadow": "2px 2px 8px #cccccc inset"
	},
	"startMenuIconNode": {
		"width": "120px",
		"height": "70px",
		"margin-top": "10px",
		"background-repeat": "no-repeat",
		"background-position": "center center"
	},
	"startMenuIconNode_over": {
	    "width": "140px",
    	"height": "70px",
    	"margin-top": "20px",
	},
	"startMenuTextNode": {
		"text-align": "center",
		"font-family": "Noto Sans KR, Apple SD Gothic Neo, Malgun Gothic, sans-serif",
		"font-size": "16px"
	},

	"startMenuNaviLeftNode": {
	    "width": "auto",
        "height": "40px",
        "float": "none",
        "display": "flex",
        "align-items": "center",
        "margin": "0px 8px 2px 8px",
        "padding": "0px 12px",
        "border-radius": "4px",
        "cursor": "pointer",
        "box-shadow": "none",
        "color": "#222222",
        "background-color": ""
	},
	"startMenuNaviLeftNode_current": {
        "color": "#2768B0",
        "background-color": "#EAF2FB"
    },
    "startMenuIconLeftNode": {
		"width": "20px",
		"height": "20px",
		"flex": "none",
		"margin": "0px 10px 0px 0px",
		"background-repeat": "no-repeat",
		"background-position": "center center",
		"background-size": "20px"
	},
	"startMenuNaviLeftPingyinNode": {
        "position": "relative",
        "order": "99",
        "height": "40px",
        "margin": "auto 8px 8px 8px",
        "border-top": "1px solid #EDEFF2"
	},
	"startMenuTextLeftNode": {
	    "display": "block",
	    "text-align": "left",
	    "font-size": "13px",
	    "font-weight": "bold",
	    "white-space": "nowrap",
	    "overflow": "hidden",
	    "text-overflow": "ellipsis"
	},

	"normalStartMenuNode": {
		"position": "static",
		"width": "191px",
		"height": "calc(100% - 12px)",
		"padding-top": "12px",
		"overflow": "hidden",
		"border-left": "0px",
		"border-top": "0px",
		"border-right": "1px solid #EDEFF2",
		"border-bottom": "0px",
		"border-radius": "0px",
		"float": "left",
		"display": "flex",
		"flex-direction": "column",
		"background-color": "#FFFFFF"
	}
}