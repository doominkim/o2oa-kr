{
  "container" : {
    "width": "100%",
    "height": "100%",
    "overflow": "hidden",
    "background-color": "#F4F5F7",
    "-webkit-user-select": "text",
    "-moz-user-select": "text"
  },
  "moduleBarNode": {
    "height": "44px",
    "line-height": "44px",
    "padding": "0px 16px",
    "box-sizing": "border-box",
    "background-color": "#2768B0",
    "color": "#FFFFFF",
    "display": "flex",
    "align-items": "center",
    "overflow": "hidden"
  },
  "moduleBarIconNode": {
    "font-size": "20px",
    "color": "#FFFFFF",
    "margin-right": "12px"
  },
  "moduleBarTextNode": {
    "font-size": "18px",
    "color": "#FFFFFF",
    "font-weight": "bold"
  },
  "lnbNode": {
    "float": "left",
    "width": "192px",
    "box-sizing": "border-box",
    "padding": "12px 0px",
    "overflow-x": "hidden",
    "overflow-y": "auto",
    "background-color": "#FFFFFF",
    "border-right": "1px solid #EDEFF2"
  },
  "lnbTreeNode": {
    "margin-top": "12px"
  },
  "mainNode": {
    "margin-left": "192px",
    "overflow": "hidden",
    "background-color": "#F4F5F7"
  },
  "scrollNode" : {
    "overflow-x": "hidden",
    "overflow-y": "auto"
  },
  "node" : {
    "overflow" : "hidden"
  },
  "titleBarContainer": {
    "overflow": "hidden",
    "height": "50px",
    "background-color" : "#FFFFFF",
    "border-bottom" : "1px solid #EDEFF2"
  },
  "titleBar" : {
    "padding" : "0px 20px",
    "height": "50px"
  },
  "titleTextNode": {
    "float": "left",
    "height": "50px",
    "line-height": "50px",
    "font-size": "18px",
    "color": "#222222",
    "max-width": "50%",
    "overflow": "hidden",
    "white-space": "nowrap",
    "text-overflow": "ellipsis"
  },
  "titleCountNode": {
    "float": "left",
    "height": "50px",
    "line-height": "52px",
    "margin-left": "8px",
    "font-size": "15px",
    "font-weight": "bold",
    "color": "#2768B0"
  },

  "createDocumentAction": {
    "margin": "0px 12px",
    "height": "34px",
    "line-height": "34px",
    "color" : "#FFFFFF",
    "font-size" : "13px",
    "text-align": "center",
    "background-color": "#2768B0",
    "border-radius": "2px",
    "cursor": "pointer"
  },
  "createDocumentAction_over": {
    "background-color": "#1F5A9C"
  },
  "createDocumentIcon": {
    "font-size": "14px",
    "margin-right": "6px",
    "vertical-align": "-1px",
    "color": "#FFFFFF"
  },
  "searchBarAreaNode": {
    "height": "50px",
    "overflow": "hidden",
    "float" : "right",
    "width" : "220px"
  },
  "searchBarNode": {
    "width" : "218px",
    "height": "28px",
    "box-sizing": "border-box",
    "background-color": "#FFF",
    "border": "1px solid #D9D9D9",
    "border-radius": "2px",
    "margin-top": "11px",
    "float": "right"
  },
  "searchBarActionNode": {
    "width": "28px",
    "height": "26px",
    "background": "url("+"../x_component_cms_Index/$Main/default/icon/search.png) center center no-repeat",
    "background-size": "16px",
    "float": "right",
    "cursor": "pointer"
  },
  "searchBarResetActionNode": {
    "width": "28px",
    "height": "26px",
    "background": "url("+"../x_component_cms_Index/$Main/default/icon/reset.png) center center no-repeat",
    "background-size": "16px",
    "float": "right",
    "cursor": "pointer"
  },
  "searchBarInputBoxNode": {
    "height": "26px",
    "line-height": "26px",
    "margin-left": "8px",
    "margin-right": "28px"
  },
  "searchBarInputNode": {
    "width": "100%",
    "height": "24px",
    "border": "0px",
    "outline": "none",
    "background": "transparent",
    "font-size": "12px",
    "color": "#666666"
  },
  "refreshAreaNode": {
    "float": "right",
    "margin": "0px 40px 0px 0px",
    "width" : "40px",
    "overflow": "hidden"
  },
  "refreshActionNode": {
    "width": "40px",
    "height": "60px",
    "line-height": "60px",
    "background": "url(../x_component_cms_Index/$Main/default/icon/refresh.png) center center no-repeat",
    "cursor": "pointer"
  },
  "columnTop_All": {
    "height": "34px",
    "line-height": "34px",
    "padding": "0px 12px 0px 16px",
    "font-size": "13px",
    "font-weight": "bold",
    "color": "#222222",
    "background-color": "transparent",
    "overflow": "hidden",
    "white-space": "nowrap",
    "text-overflow": "ellipsis",
    "cursor": "pointer"
  },
  "columnTop_All_over": {
    "background-color": "#F4F5F7"
  },
  "columnTop_All_current": {
    "color": "#2768B0",
    "background-color": "#EAF2FB"
  },
  "columnTop_AllIcon": {
    "font-size": "16px",
    "margin-right": "8px",
    "vertical-align": "-2px",
    "font-weight": "normal"
  },

  "columnTop_import": {
    "float": "right",
    "margin-right": "30px",
    "width": "56px",
    "background": "url(../x_component_cms_Column/$Main/default/icon/icon__leading_in_grey.png) 0 center no-repeat",
    "padding-left": "22px",
    "height": "50px",
    "line-height": "50px",
    "font-size": "14px",
    "color": "#333333",
    "cursor": "pointer"
  },
  "columnTop_category": {
    "overflow": "hidden",
    "position": "static",
    "z-index" : "auto",
    "box-shadow": "none"
  },
  "columnTop_category_more": {
    "position": "absolute",
    "z-index" : "10",
    "box-shadow": "0 0 10px #999999 "
  },
  "columnTop_categoryItem": {
    "position": "relative",
    "height": "34px",
    "line-height": "34px",
    "padding": "0px 40px 0px 40px",
    "font-size": "13px",
    "font-weight": "normal",
    "color": "#444444",
    "background-color": "transparent",
    "overflow": "hidden",
    "white-space": "nowrap",
    "text-overflow": "ellipsis",
    "cursor": "pointer"
  },
  "columnTop_categoryItem_over": {
    "background-color": "#F4F5F7"
  },
  "columnTop_categoryItem_current": {
    "color": "#2768B0",
    "background-color": "#EAF2FB"
  },
  "columnTop_categoryCount": {
    "position": "absolute",
    "right": "14px",
    "top": "0px",
    "font-size": "12px",
    "color": "#2768B0",
    "pointer-events": "none"
  },

  "columnTop_categoryExpandButtonArea": {
    "height": "10px",
    "width": "100%",
    "position": "absolute",
    "margin": "auto",
    "bottom": "2px"
  },
  "columnTop_categoryExpandButton": {
    "display": "none"
  },

  "contentContainerNode" : {
    "overflow": "hidden"
  },
  "contentNode" : {
    "display": "grid",
    "grid-template-columns": "repeat(auto-fill, minmax(440px, 1fr))",
    "grid-gap": "16px",
    "padding": "20px",
    "-webkit-user-select": "none",
    "-moz-user-select": "none"
  },
  "emptyNode": {
    "grid-column": "1 / -1",
    "padding": "80px 0px",
    "text-align": "center"
  },
  "emptyIconNode": {
    "font-size": "48px",
    "color": "#C8CDD3"
  },
  "emptyTextNode": {
    "margin-top": "12px",
    "font-size": "12px",
    "color": "#8C8C8C"
  },
  "columnItemNode" : {
    "position": "relative",
    "min-width": "0px",
    "box-sizing": "border-box",
    "padding": "16px 20px 12px 20px",
    "background-color" : "#FFFFFF",
    "border-radius": "8px",
    "box-shadow": "0 1px 4px rgba(0,0,0,.08)"
  },
  "columnItemLeftNode": {
    "display": "flex",
    "align-items": "center",
    "height" : "40px",
    "overflow": "hidden",
    "cursor" : "pointer"
  },
  "columnItemRightNode": {
    "overflow": "hidden",
    "cursor" : "pointer"
  },
  "columnItemTopNode": {
    "overflow": "hidden",
    "background-color": "#FFF",
    "cursor" : "pointer"
  },
  "columnItemNode_select": {
  },
  "columnItemIconAreaNode" : {
    "flex": "none",
    "width": "32px",
    "height": "32px",
    "margin-right": "10px"
  },
  "columnItemIconNode": {
    "width": "32px",
    "height": "32px",
    "border-radius": "8px"
  },
  "columnItemTextNode": {
    "flex": "1",
    "min-width": "0px",
    "overflow": "hidden"
  },
  "columnItemTitleNode": {
    "color": "#222222",
    "line-height": "20px",
    "font-size": "15px",
    "font-weight": "bold",
    "overflow" : "hidden",
    "white-space": "nowrap",
    "text-overflow": "ellipsis"
  },
  "columnItemDescriptionNode" : {
    "overflow" : "hidden",
    "color": "#8C8C8C",
    "line-height": "18px",
    "font-size": "12px",
    "white-space": "nowrap",
    "text-overflow": "ellipsis"
  },
  "columnItemMoreNode": {
    "flex": "none",
    "margin-left": "12px",
    "font-size": "12px",
    "color": "#8C8C8C"
  },
  "columnItemMoreIcon": {
    "font-size": "12px",
    "margin-left": "2px",
    "vertical-align": "-1px"
  },
  "categoryContainer" : {
    "margin-top": "10px",
    "height" :"30px",
    "overflow" : "hidden"
  },
  "categoryArrowNode" : {
    "width": "20px",
    "height": "30px",
    "cursor" : "pointer",
    "background":"url(../x_component_cms_Index/$Main/default/icon/down.png) center center no-repeat",
    "float" : "right",
    "background-color" : "#fff"
  },
  "categoryArrowNode_over" : {
    "background":"url(../x_component_cms_Index/$Main/default/icon/down_over.png) center center no-repeat"
  },
  "categoryArrowNode_down" : {
    "background":"url(../x_component_cms_Index/$Main/default/icon/up.png) center center no-repeat",
    "background-color" : "#fff"
  },
  "categoryArrowNode_down_over" : {
    "background":"url(../x_component_cms_Index/$Main/default/icon/up_over.png) center center no-repeat",
    "float" : "right"
  },
  "categoryList" : {
    "width": "calc(100% - 24px)",
    "float" : "left",
    "position" : "static",
    "border":"0",
    "padding-bottom": "0px",
    "background-color": "transparent",
    "box-shadow": "none",
    "z-index": 0
  },
  "categoryList_all" : {
    "position" : "absolute",
    "top": "0px",
    "left": "0px",
    "width": "calc(100% - 24px)",
    "box-sizing": "border-box",
    "padding": "0px 6px 8px 6px",
    "border" : "1px solid #E6E6E6",
    "border-radius": "4px",
    "background-color" : "#fff",
    "box-shadow": "0 2px 8px rgba(0,0,0,.12)",
    "z-index": 1
  },
  "categoryItem" : {
    "float" : "left",
    "cursor" : "pointer",
    "margin": "4px 6px 0px 0px",
    "height": "22px",
    "line-height": "22px",
    "padding": "0px 8px",
    "color": "#2768B0",
    "font-size": "12px",
    "border" : "1px solid #EAF2FB",
    "border-radius": "2px",
    "background-color" : "#EAF2FB",
    "white-space":"nowrap"
  },
  "categoryItem_over" : {
    "color": "#fff",
    "border" : "1px solid #2768B0",
    "background-color" : "#2768B0"
  },
  "documentHead": {
    "display": "flex",
    "margin-top": "10px",
    "height": "30px",
    "line-height": "30px",
    "padding": "0px 10px",
    "background-color": "#F2F6F8",
    "border-radius": "4px",
    "font-size": "12px",
    "color": "#8C8C8C",
    "text-align": "center"
  },
  "documentHeadTitle": {
    "flex": "1"
  },
  "documentHeadPerson": {
    "flex": "none",
    "width": "80px"
  },
  "documentHeadDate": {
    "flex": "none",
    "width": "84px"
  },
  "documentList" : {
    "min-height": "34px"
  },
  "documentItem" : {
    "display": "flex",
    "align-items": "center",
    "height": "36px",
    "line-height" : "36px",
    "padding": "0px 10px",
    "border-bottom" : "1px solid #EDEFF2",
    "font-size": "13px",
    "color": "#222222",
    "background-color": "transparent",
    "cursor" : "pointer"
  },
  "documentItem_over" : {
    "color": "#2768B0",
    "background-color": "#EAF2FB"
  },
  "documentItem_top": {
  },
  "documentItemTitle": {
    "flex": "1",
    "min-width": "0px",
    "overflow":"hidden",
    "white-space":"nowrap",
    "text-overflow" : "ellipsis"
  },
  "documentItemPerson": {
    "flex": "none",
    "width": "80px",
    "text-align": "center",
    "font-size": "12px",
    "color": "#8C8C8C",
    "overflow":"hidden",
    "white-space":"nowrap",
    "text-overflow" : "ellipsis"
  },
  "documentItemDate": {
    "flex": "none",
    "width": "84px",
    "text-align": "center",
    "font-size": "12px",
    "color": "#8C8C8C"
  },
  "documentTopNode": {
    "flex": "none",
    "margin-left": "6px",
    "height": "16px",
    "width": "16px",
    "border-radius": "2px",
    "background-color": "#F0504F",
    "background-size":"10px",
    "background-position":"center center",
    "background-repeat": "no-repeat",
    "background-image": "url(../x_component_Homepage/$Main/default/icon/top.png)"
  },
  "documentTopNode_over": {
    "background-color": "#F0504F"
  },
  "moreArea" : {
    "height": "30px",
    "line-height" : "30px",
    "text-align": "right",
    "overflow" : "hidden",
    "cursor": "pointer"
  },
  "moreLinkText" : {
    "display" : "inline-block",
    "font-size": "12px",
    "color" : "#8C8C8C",
    "cursor" : "pointer",
    "margin-right" : "4px"
  },
  "moreLinkImage" : {
    "display" : "inline-block",
    "width" : "14px",
    "height" : "14px",
    "vertical-align": "-2px",
    "background":"url(../x_component_cms_Index/$Main/default/icon/right.png) 0px 0px no-repeat"
  },
  "moreLinkText_over" : {
    "color": "#2768B0"
  },
  "moreLinkImage_over" : {
    "background":"url(../x_component_cms_Index/$Main/default/icon/right_over.png) 0px 0px no-repeat"
  },

  "rightContentNode": {
    "height": "100%",
    "margin-left": "200px",
    "overflow": "hidden",
    "opacity": 1
  }
}
