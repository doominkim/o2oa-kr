    "-moz-user-select": "text"
  },
  "moduleBarNode": {
    "height": "44px",
    "line-height": "44px",
    "padding": "0px 16px",
    "box-sizing": "border-box",
    "background-color": "#2768B0",
    "color": "#FFFFFF",
    "display": "flex",
    "align-items": "center",
    "overflow": "hidden"
  },
  "moduleBarIconNode": {
    "font-size": "20px",
    "color": "#FFFFFF",
    "margin-right": "12px"
  },
  "moduleBarTextNode": {
    "font-size": "18px",
    "color": "#FFFFFF",
    "font-weight": "bold"
  },
  "rightContentNode": {
    "height": "100%",
    "margin-left": "192px",
    "padding": "0px 20px",
    "overflow": "hidden",
    "background-color" : "#fff",
    "opacity": 1
  },
  "naviContainerNode": {
    "border-right" : "1px solid #EDEFF2",
