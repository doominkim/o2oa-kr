  },
  "titleIconAreaNode" : {
    "flex": "none",
    "width": "18px",
    "height": "18px",
    "margin-right": "8px"
  },
  "titleIconNode": {
    "display": "block",
    "width": "18px",
    "height": "18px",
    "border-radius": "4px"
  },
  "titleContentNode" : {
    "flex": "1",
